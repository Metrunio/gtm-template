___TESTS___

scenarios:
- name: Loads the script from Metrunio and initialises the tracker
  code: |-
    let loadedUrl;
    let config;
    mock('injectScript', (url, onSuccess, onFailure, cacheToken) => {
      loadedUrl = url;
      onSuccess();
    });
    mock('callInWindow', (name, value) => {
      if (name === 'metrunio.init') config = value;
    });

    runCode({ siteId: 'site_test', writeKey: 'wk_test', endpoint: '', analyticsConsent: true, marketingConsent: false });

    assertThat(loadedUrl).isEqualTo('https://collect.metrunio.com/v1/t.js');
    assertThat(config.siteId).isEqualTo('site_test');
    assertThat(config.endpoint).isEqualTo('https://collect.metrunio.com');
    assertThat(config.consent.analytics).isTrue();
    assertThat(config.consent.marketing).isFalse();
    assertApi('gtmOnSuccess').wasCalled();
- name: Reports no consent decision when both boxes are empty
  code: |-
    let config;
    mock('injectScript', (url, onSuccess, onFailure, cacheToken) => {
      onSuccess();
    });
    mock('callInWindow', (name, value) => {
      if (name === 'metrunio.init') config = value;
    });

    runCode({ siteId: 'site_test', writeKey: 'wk_test', endpoint: '', analyticsConsent: false, marketingConsent: false });

    assertThat(config.consent).isUndefined();
    assertApi('gtmOnSuccess').wasCalled();
- name: Sends to the own measurement domain of the customer
  code: |-
    let loadedUrl;
    let config;
    mock('injectScript', (url, onSuccess, onFailure, cacheToken) => {
      loadedUrl = url;
      onSuccess();
    });
    mock('callInWindow', (name, value) => {
      if (name === 'metrunio.init') config = value;
    });

    runCode({ siteId: 'site_test', writeKey: 'wk_test', endpoint: 'https://gauge.example.com' });

    assertThat(loadedUrl).isEqualTo('https://collect.metrunio.com/v1/t.js');
    assertThat(config.endpoint).isEqualTo('https://gauge.example.com');
    assertApi('gtmOnSuccess').wasCalled();
- name: Reports a failure when the script cannot load
  code: |-
    mock('injectScript', (url, onSuccess, onFailure, cacheToken) => {
      onFailure();
    });

    runCode({ siteId: 'site_test', writeKey: 'wk_test', endpoint: '' });

    assertApi('gtmOnFailure').wasCalled();
    assertApi('gtmOnSuccess').wasNotCalled();
- name: Loads the consent bridge for the chosen consent tool
  code: |-
    const loaded = [];
    let bridgeConfig;
    mock('injectScript', (url, onSuccess, onFailure, cacheToken) => {
      loaded.push(url);
      onSuccess();
    });
    mock('setInWindow', (name, value) => {
      if (name === 'metrunioConsentBridgeConfig') bridgeConfig = value;
      return true;
    });

    runCode({ siteId: 'site_test', writeKey: 'wk_test', endpoint: '', consentTool: 'usercentrics' });

    assertThat(loaded).contains('https://collect.metrunio.com/v1/consent-bridge.js');
    assertThat(bridgeConfig.source).isEqualTo('usercentrics');
    assertApi('gtmOnSuccess').wasCalled();
- name: Hands a goal step with customer ID to the running tracker after consent
  code: |-
    const called = [];
    mock('callInWindow', (name, first, second) => {
      if (name === 'metrunio.getConsent') return { state: 'granted', purposes: [] };
      called.push([name, first, second]);
    });

    runCode({ tagType: 'conversion', conversionType: 'goal', goalKey: 'signed_up', customerId: 'acc-4711' });

    assertThat(called[0][0]).isEqualTo('metrunio.identify');
    assertThat(called[0][1]).isEqualTo('acc-4711');
    assertThat(called[1][0]).isEqualTo('metrunio.goal');
    assertThat(called[1][1]).isEqualTo('signed_up');
    assertApi('gtmOnSuccess').wasCalled();
- name: Hands a purchase with value and currency to the running tracker
  code: |-
    let input;
    mock('callInWindow', (name, value) => {
      if (name === 'metrunio.getConsent') return { state: 'partial', purposes: ['analytics'] };
      if (name === 'metrunio.conversion') input = value;
    });

    runCode({ tagType: 'conversion', conversionType: 'purchase', orderId: 'B-1001', value: '49,90', currency: 'eur' });

    assertThat(input.type).isEqualTo('purchase');
    assertThat(input.orderId).isEqualTo('B-1001');
    assertThat(input.value).isEqualTo(49.9);
    assertThat(input.currency).isEqualTo('EUR');
    assertApi('gtmOnSuccess').wasCalled();
- name: Drops a conversion without a consent decision and does not hold it back
  code: |-
    let sent = false;
    mock('callInWindow', (name) => {
      if (name === 'metrunio.getConsent') return { state: 'unknown', purposes: [] };
      if (name !== 'metrunio.getConsent') sent = true;
    });

    runCode({ tagType: 'conversion', conversionType: 'lead', leadId: 'L-1' });

    assertThat(sent).isFalse();
    assertApi('gtmOnSuccess').wasCalled();
- name: Drops a conversion before Metrunio has loaded when no decision is queued
  code: |-
    let queued = false;
    mock('copyFromWindow', (name) => {
      if (name === 'metrunioQueue') return [['init', { siteId: 'site_test' }]];
    });
    mock('createQueue', (name) => {
      return () => { queued = true; };
    });

    runCode({ tagType: 'conversion', conversionType: 'purchase', orderId: 'B-1001' });

    assertThat(queued).isFalse();
    assertApi('gtmOnSuccess').wasCalled();
- name: Fails a purchase without an order number
  code: |-
    mock('callInWindow', (name) => {
      if (name === 'metrunio.getConsent') return { state: 'granted', purposes: [] };
    });

    runCode({ tagType: 'conversion', conversionType: 'purchase', orderId: '' });

    assertApi('gtmOnFailure').wasCalled();
    assertApi('gtmOnSuccess').wasNotCalled();

___NOTES___

Metrunio Tracking. Site ID and Write Key are in the Metrunio portal under
Setup. Publish the container after adding the tag. For leads, goal steps and
purchases, add a second tag of type Conversion and fire it after the base tag.
