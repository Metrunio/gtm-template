const injectScript = require('injectScript');
const copyFromWindow = require('copyFromWindow');
const setInWindow = require('setInWindow');
const callInWindow = require('callInWindow');
const createQueue = require('createQueue');
const getType = require('getType');
const makeNumber = require('makeNumber');
const makeString = require('makeString');
const templateStorage = require('templateStorage');
const log = require('logToConsole');

const MARKETING_PURPOSES = ['marketing', 'ad_storage', 'advertising'];
const AD_EVENTS = ['ad_impression', 'ad_viewable_impression', 'ad_click'];
const MEASURE_CALLS = ['page', 'track', 'identify', 'conversion', 'goal'];

const needOf = (call) => {
  const name = call[0];
  if (name === 'survey' || name === 'renderSurvey' || name === 'fillForm') return 'analytics';
  if (name === 'track' && AD_EVENTS.indexOf(call[1]) >= 0) return 'marketing';
  return MEASURE_CALLS.indexOf(name) >= 0 ? 'any' : 'none';
};

const grantsOf = (consent, category) => {
  if (getType(consent) !== 'object') return null;
  let state = consent.state;
  let purposes = consent.purposes;
  if (!state) {
    state = consent.analytics && consent.marketing ? 'granted' : consent.analytics || consent.marketing ? 'partial' : 'denied';
    if (getType(purposes) !== 'array') {
      purposes = [];
      if (consent.analytics) purposes.push('analytics');
      if (consent.marketing) purposes.push('marketing');
    }
  }
  if (state === 'unknown') return null;
  const grants = { any: false, analytics: false, marketing: false };
  if (state !== 'granted' && state !== 'partial') return grants;
  if (getType(purposes) !== 'array') purposes = [];
  grants.any = true;
  grants.analytics = state === 'granted';
  grants.marketing = state === 'granted' && purposes.length === 0;
  purposes.forEach((purpose) => {
    const name = makeString(purpose).toLowerCase();
    if (MARKETING_PURPOSES.indexOf(name) >= 0 || (category && name === category)) grants.marketing = true;
    else grants.analytics = true;
  });
  return grants;
};

const filterQueue = (calls) => {
  const kept = [];
  let consent = null;
  let category = '';
  let initSeen = false;
  const keep = (call) => {
    const need = needOf(call);
    if (need === 'none') return call;
    const grants = grantsOf(consent, category);
    if (grants && grants[need]) return call;
    return call[0] === 'page' && !grants ? ['page'] : null;
  };
  const recheck = () => {
    for (let i = kept.length - 1; i >= 0; i--) {
      const call = keep(kept[i]);
      if (call) kept[i] = call;
      else kept.splice(i, 1);
    }
  };
  (getType(calls) === 'array' ? calls : []).forEach((call) => {
    if (getType(call) !== 'array' || call.length === 0) return;
    const argument = call[1];
    if (call[0] === 'init') {
      if (!initSeen && getType(argument) === 'object' && argument.marketingCategory) category = makeString(argument.marketingCategory).toLowerCase();
      initSeen = true;
      if (getType(argument) === 'object' && argument.consent) {
        consent = argument.consent;
        recheck();
      }
    } else if (call[0] === 'setConsent') {
      consent = getType(argument) === 'object' ? argument : {};
      recheck();
    }
    const checked = keep(call);
    if (checked) kept.push(checked);
  });
  return kept;
};

const textOf = (value) => (value === undefined || value === null ? '' : makeString(value).trim());

const send = (calls) => {
  calls.forEach((call) => {
    if (call[0] === 'identify') callInWindow('metrunio.identify', call[1]);
    else if (call[0] === 'goal') callInWindow('metrunio.goal', call[1], call[2]);
    else callInWindow('metrunio.conversion', call[1]);
  });
};

const runBase = () => {
  const url = 'https://collect.metrunio.com/v1/t.js';
  const endpoint = data.endpoint || 'https://collect.metrunio.com';
  setInWindow('metrunioQueue', filterQueue(copyFromWindow('metrunioQueue')), true);

  const config = { siteId: data.siteId, writeKey: data.writeKey, endpoint: endpoint };
  if (data.analyticsConsent || data.marketingConsent) {
    config.consent = { analytics: data.analyticsConsent === true, marketing: data.marketingConsent === true };
  }
  templateStorage.setItem('baseConsent', config.consent || null);
  templateStorage.setItem('base', 'loading');

  if (data.consentTool) {
    const bridgeUrl = 'https://collect.metrunio.com/v1/consent-bridge.js';
    setInWindow('metrunioConsentBridgeConfig', { source: data.consentTool }, true);
    injectScript(bridgeUrl, () => {}, () => log("Metrunio: the consent bridge could not be loaded: " + bridgeUrl), 'metrunioConsentBridge');
  }

  const flush = (loaded) => {
    const pending = templateStorage.getItem('pending');
    templateStorage.removeItem('pending');
    if (loaded && getType(pending) === 'array') pending.forEach(send);
  };

  const onSuccess = () => {
    callInWindow('metrunio.init', config);
    templateStorage.setItem('base', 'ready');
    flush(true);
    data.gtmOnSuccess();
  };

  const onFailure = () => {
    setInWindow('metrunioQueue', filterQueue(copyFromWindow('metrunioQueue')), true);
    templateStorage.setItem('base', 'failed');
    flush(false);
    log("Metrunio could not be loaded: " + url);
    data.gtmOnFailure();
  };

  injectScript(url, onSuccess, onFailure, 'metrunioTracking');
};

const conversionCalls = () => {
  const kind = data.conversionType || 'goal';
  if (kind === 'goal') {
    const key = textOf(data.goalKey);
    if (!key) return { error: "Metrunio: the goal step has no key. The field was empty." };
    const calls = [];
    const customer = textOf(data.customerId);
    if (customer) calls.push(['identify', customer]);
    calls.push(['goal', key, {}]);
    return { calls: calls };
  }
  const input = { type: kind };
  const rawValue = textOf(data.value);
  if (rawValue) {
    const value = makeNumber(rawValue.replace(',', '.'));
    if (value === value) input.value = value;
    else log("Metrunio: the value is not a number and is left out: " + rawValue);
  }
  const currency = textOf(data.currency);
  if (currency) input.currency = currency.toUpperCase();
  if (kind === 'purchase') {
    const orderId = textOf(data.orderId);
    if (!orderId) return { error: "Metrunio: the purchase has no order number. The field was empty." };
    input.orderId = orderId;
  } else {
    const leadId = textOf(data.leadId);
    if (leadId) input.leadId = leadId;
    else log("Metrunio: lead without a lead ID. Metrunio takes the ID from a form in this session; if there is none, Metrunio does not accept the lead.");
  }
  return { calls: [['conversion', input]] };
};

const runConversion = () => {
  const built = conversionCalls();
  if (built.error) {
    log(built.error);
    data.gtmOnFailure();
    return;
  }
  const calls = built.calls;

  const sdkConsent = callInWindow('metrunio.getConsent');
  if (getType(sdkConsent) === 'object') {
    if (sdkConsent.state === 'granted' || sdkConsent.state === 'partial') {
      send(calls);
      log("Metrunio: conversion handed over", calls);
    } else if (sdkConsent.state === 'denied') {
      log("Metrunio: conversion not measured because consent was refused.");
    } else {
      log("Metrunio: conversion dropped because no decision had been made in the banner yet. Metrunio does not hold it back. Fire this tag only after the action and after the decision, place it after the base tag in tag sequencing, or report the conversion through the server route.");
    }
    data.gtmOnSuccess();
    return;
  }

  const raw = copyFromWindow('metrunioQueue');
  const queued = getType(raw) === 'array' ? raw : [];
  const baseConsent = templateStorage.getItem('baseConsent');
  const decided = queued.concat(getType(baseConsent) === 'object' ? [['init', { consent: baseConsent }]] : []);
  const held = filterQueue(decided.concat(calls)).length - filterQueue(decided).length === calls.length;
  if (!held) {
    log("Metrunio: conversion dropped because no decision had been made in the banner yet. Metrunio does not hold it back. Fire this tag only after the action and after the decision, place it after the base tag in tag sequencing, or report the conversion through the server route.");
  } else if (queued.some((call) => getType(call) === 'array' && call[0] === 'init')) {
    const push = createQueue('metrunioQueue');
    calls.forEach((call) => push(call));
    log("Metrunio: conversion handed over", calls);
  } else if (templateStorage.getItem('base') === 'failed') {
    log("Metrunio: conversion dropped because Metrunio could not be loaded.");
  } else {
    const pending = templateStorage.getItem('pending');
    templateStorage.setItem('pending', (getType(pending) === 'array' ? pending : []).concat([calls]));
    log("Metrunio: conversion accepted with consent. It goes out as soon as the base tag has loaded Metrunio.", calls);
  }
  data.gtmOnSuccess();
};

if (data.tagType === 'conversion') runConversion();
else runBase();

